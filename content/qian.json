[{"grade":"上上签","id":1,"jie":"阴霾尽散，好事将近，只管大步向前。","poem":["云开雾散见青天","万里江山入画篇","莫道前程多险阻","春风已度玉门关"]},{"grade":"上签","id":2,"jie":"有贵人相助，但根基还得自己打牢。","poem":["一竿钓起锦鳞鱼","喜气盈门百事如","贵人暗助三分力","自家福田自家锄"]},{"grade":"上签","id":3,"jie":"时机正好，想做的事别再拖延。","poem":["桃李花开正及时","东风送暖入帘帷","心中所愿休迟疑","趁取春光莫待迟"]},{"grade":"中平签","id":4,"jie":"暂且收敛锋芒，等风来再出发。","poem":["行船且候顺风潮","急水滩头莫逞豪","退后一步心自静","他年扬帆过石桥"]},{"grade":"中平签","id":5,"jie":"眼下困顿只是转弯处，再走几步就通了。","poem":["山重水复疑无路","柳暗花明又一村","莫将愁眼看世界","转过弯来即是春"]},{"grade":"上上签","id":6,"jie":"积累已够，只等一阵风，莫自轻看。","poem":["金鳞岂是池中物","一遇风云便化龙","多载寒窗无人问","今朝得遂平生志"]},{"grade":"中平签","id":7,"jie":"所求之外另有风景，换个眼光看问题。","poem":["明月清风本无价","近水远山皆有情","求名求利皆辛苦","不如归去听松声"]},{"grade":"下平签","id":8,"jie":"眼下清冷难熬，守住本心，忌冲动行事。","poem":["风雨潇潇夜未央","孤舟独钓寒江上","莫嫌鱼讯来迟缓","守得云开见月光"]},{"grade":"上签","id":9,"jie":"苦功不会白费，继续按自己的节奏走。","poem":["宝剑锋从磨砺出","梅花香自苦寒来","君家自有凌云志","不用扬鞭自奋蹄"]},{"grade":"中平签","id":10,"jie":"想通一件事的关键，是去找源头活水。","poem":["半亩方塘一鉴开","天光云影共徘徊","问渠那得清如许","为有源头活水来"]},{"grade":"上签","id":11,"jie":"牵挂的事很快有确切消息，安心等信。","poem":["喜鹊登枝报佳音","门前嘉客踏青云","多时悬悬心头事","今日方知有着落"]},{"grade":"下平签","id":12,"jie":"耳闻未必为实，少听多看，守成为上。","poem":["雾里看花花不真","水中望月月难亲","劝君莫听闲言语","守旧安然自有春"]},{"grade":"上上签","id":13,"jie":"天时地利人和齐备，放手去做。","poem":["旭日初升照大千","群山让路水让船","平生抱负今朝展","好风凭借力无边"]},{"grade":"中平签","id":14,"jie":"别为眼前小利乱了大局，稳住后手。","poem":["棋到中盘未分明","莫贪一子失全局","留得青山柴不尽","后发先至亦可期"]},{"grade":"上签","id":15,"jie":"困局得解，还会遇上意想不到的帮手。","poem":["久旱逢霖草木欣","他乡遇故倍知亲","心头旧事如云散","从此逍遥自在身"]},{"grade":"中平签","id":16,"jie":"少跟人比，自家田里按时耕，自有收成。","poem":["种瓜得瓜本寻常","莫羡他人插柳成","各人自有各人福","守得田园秋有成"]},{"grade":"下平签","id":17,"jie":"正处吃力阶段，最忌半途松劲，撑过去就好。","poem":["逆水行舟用力撑","一篙松劲退千寻","劝君且莫心先怯","咬紧牙关过险津"]},{"grade":"上签","id":18,"jie":"身边已有难得的人和事，用心珍惜。","poem":["兰室芝房香满庭","良缘夙缔自天成","莫教风雨摧残却","珍重眼前有福人"]},{"grade":"中平签","id":19,"jie":"想看清局面，先把自己的位置抬高一层。","poem":["欲穷千里目无涯","更上一层楼自佳","莫道高处不胜寒","眼界宽时天地大"]},{"grade":"上上签","id":20,"jie":"志向不妨定得大些，风已经起了。","poem":["鲲鹏展翅九万里","扶摇直上入云端","莫笑少年多壮志","他年回首已非凡"]},{"grade":"上签","id":21,"jie":"烦恼正在退场，顺势而为，安稳收尾。","poem":["秋水长天共一色","渔舟唱晚顺风归","心头烦恼随流水","从此安然无是非"]},{"grade":"中平签","id":22,"jie":"不争也有光，守住自己的节奏就好。","poem":["墙角数枝梅正开","不争春色自多才","莫嫌冷落无人赏","清香自会引人来"]},{"grade":"上上签","id":23,"jie":"大胆启程，路会越走越宽。","poem":["长风破浪会有时","直挂云帆向天涯","莫愁前路无知己","且放宽心闯天下"]},{"grade":"下平签","id":24,"jie":"先避锋芒，坏天气不会一直下。","poem":["乌云压城城欲摧","狂风骤雨一时催","且向檐下暂避步","雨过青山翠欲堆"]},{"grade":"上签","id":25,"jie":"前期慢是扎根，别急着验收成果。","poem":["播下种子莫心焦","春雨无声细润苗","他日田园瓜果熟","先苦后甜滋味饶"]},{"grade":"中上签","id":26,"jie":"先把工具磨利，机会来时才接得住。","poem":["磨刀不误砍柴工","蓄势待发自从容","待到东风吹面暖","一举成名天下知"]},{"grade":"中平签","id":27,"jie":"少评判多自省，路反而更宽。","poem":["静坐常思自己过","闲谈莫论他人非","心宽一寸路宽丈","退后原来是向前"]},{"grade":"上签","id":28,"jie":"翻篇是福，轻装上路，好事在排队。","poem":["旧岁已随流水去","新春又送暖风来","放下包袱轻装行","好事排队等你开"]},{"grade":"下签","id":29,"jie":"此刻最忌冒险，平安落地就是赢。","poem":["深渊薄冰夜行人","步步惊心步步惊","劝君暂止贪快念","守得平安即是金"]},{"grade":"中平签","id":30,"jie":"凡事别做满，留三分余地最长久。","poem":["半开半合花最艳","半醉半醒梦最长","凡事留有三分地","不尽之意味悠长"]},{"grade":"上签","id":31,"jie":"在哪里都能扎根，心安即是家。","poem":["他乡漂泊莫思量","明月清风是故乡","随遇而安天地阔","何处不是好风光"]},{"grade":"中上签","id":32,"jie":"磨难是筛选，熬过去成色就出来了。","poem":["千淘万漉虽辛苦","吹尽狂沙始到金","莫道眼前多磨折","真金原要火来侵"]},{"grade":"中平签","id":33,"jie":"交情慢慢验，别急着掏心掏肺。","poem":["人情似纸张张薄","世事如棋局局新","莫把真心轻付予","且看时久见人心"]},{"grade":"上上签","id":34,"jie":"势头正旺，借力而上，正是时候。","poem":["红日初升万象新","紫气东来满门春","贵人扶上青云路","从此平步入高云"]},{"grade":"下平签","id":35,"jie":"难走的是一段夜路，天总会亮的。","poem":["路滑霜浓夜色寒","独行客子正艰难","且将心事付明月","守到天明路自宽"]},{"grade":"上签","id":36,"jie":"只管耕耘，收成自有它的时辰。","poem":["春种一粒粟未收","秋来万颗子盈仓","只管耕耘莫问报","时节到了自然香"]},{"grade":"中平签","id":37,"jie":"想不通就先放下，清净自有答案。","poem":["清泉石上流声细","明月松间照影疏","心事如丝抽不尽","不如放下读闲书"]},{"grade":"中上签","id":38,"jie":"大事都是小事攒出来的，继续攒。","poem":["燕子衔泥筑新巢","不辞辛苦往返劳","小事积成大家业","平凡日子见功高"]},{"grade":"上签","id":39,"jie":"重逢是缘，珍惜眼前这场相聚。","poem":["久别重逢喜欲狂","把酒言欢话短长","旧情新谊皆珍重","莫负今宵好时光"]},{"grade":"中平签","id":40,"jie":"越使劲越落空，松手反有意外之喜。","poem":["有意栽花花不开","无心插柳柳成行","强求之事多落空","顺其自然福自来"]},{"grade":"下平签","id":41,"jie":"硬顶要吃亏，先退一步再图后计。","poem":["逆风执炬火烧手","顶浪行舟浪打头","识时务者为俊杰","暂避风头再计谋"]},{"grade":"上上签","id":42,"jie":"好事临门，更要稳住别飘。","poem":["金榜题名墨未干","洞房花烛夜初阑","人生得意须珍惜","更上一层莫自满"]},{"grade":"中平签","id":43,"jie":"别急着下结论，先承认自己看得少。","poem":["井蛙不可语沧海","夏虫不可语冰寒","眼界之外有天地","虚心方得见真山"]},{"grade":"上签","id":44,"jie":"只差一阵风，蓄好势别泄气。","poem":["大鹏一日同风起","扶摇直上九万里","莫叹如今身未显","只待时来天地低"]},{"grade":"中平签","id":45,"jie":"得失看淡，心安比什么都重要。","poem":["一碗清茶敬岁月","半窗明月伴清宵","得失荣枯皆过客","心安之处是吾乡"]},{"grade":"中上签","id":46,"jie":"积累从不骗人，慢功夫有大回报。","poem":["积土成山风雨兴","积水成渊蛟龙生","平日功夫休看轻","水滴石穿见真功"]},{"grade":"下签","id":47,"jie":"虚的东西追不得，脚踏实地回头是岸。","poem":["镜里花容留不住","水中月影捞成空","劝君莫逐虚名利","回头脚下路才通"]},{"grade":"上签","id":48,"jie":"旧烦恼会自己翻篇，新景正在路上。","poem":["柳絮随风去又回","桃花依旧笑春风","去年烦恼今年忘","新景新程新气象"]},{"grade":"中平签","id":49,"jie":"时间会给答案，别用一时定终身。","poem":["路遥知马力方显","日久见人心自明","莫凭一时论成败","且行且看且从容"]},{"grade":"上签","id":50,"jie":"走着看，桥到船头自然直。","poem":["青山不老绿水长","前路迢迢莫彷徨","一步一景皆风景","走到桥头自然直"]},{"grade":"中上签","id":51,"jie":"笨功夫最可靠，临场自有神助。","poem":["读书破万卷虽勤","下笔如有神来亲","平日下的笨功夫","临场方显不寻常"]},{"grade":"中平签","id":52,"jie":"起落是常态，平常心是最稳的底盘。","poem":["花开花落自有时","月圆月缺本无奇","盛时不骄衰不馁","平常心里藏天机"]},{"grade":"下平签","id":53,"jie":"难处自己消化，冬天熬完就是春。","poem":["寒鸦立尽枯枝头","暮色苍茫水自流","莫向人前诉凄苦","熬过寒冬便是春"]},{"grade":"上签","id":54,"jie":"记住雪中送炭的人，这份情要还。","poem":["贵人相逢于微时","患难之中见真情","莫忘当年扶持手","他日当报涌泉恩"]},{"grade":"中平签","id":55,"jie":"对手是镜子，争一时不如修自己。","poem":["棋逢对手难分胜","将遇良才各显能","莫因一时争高下","和气方能久安宁"]},{"grade":"上上签","id":56,"jie":"顺遂安稳之象，享受这份从容。","poem":["宝鼎茶闲烟尚绿","幽窗棋罢指犹凉","功成名就身心泰","岁月静好福绵长"]},{"grade":"中平签","id":57,"jie":"无事一身轻，少揽事就是福。","poem":["野渡无人舟自横","春潮带雨晚来晴","世事浮沉皆如此","心头无事一身轻"]},{"grade":"上签","id":58,"jie":"这关是茧，破了就是艳阳天。","poem":["破茧方知蝶之美","经霜更觉菊之香","眼前这关虽难过","过了便是艳阳天"]},{"grade":"中平签","id":59,"jie":"开口前想三秒，留人三分是留自己。","poem":["三思而后行方稳","量力而为步不惊","莫逞一时口头快","留人三分即留己"]},{"grade":"下平签","id":60,"jie":"现在看不清是正常的，等水静了再说。","poem":["浮云遮月月不明","浊水浑沙沙不清","且待风清水静后","真相自会现原形"]}]