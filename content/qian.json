[{"grade":"上上签","id":1,"jie":"阴霾尽散，好事将近，只管大步向前。","poem":["云开雾散见青天","万里江山入画篇","莫道前程多险阻","春风已度玉门关"]},{"grade":"上签","id":2,"jie":"有贵人相助，但根基还得自己打牢。","poem":["一竿钓起锦鳞鱼","喜气盈门百事如","贵人暗助三分力","自家福田自家锄"]},{"grade":"上签","id":3,"jie":"时机正好，想做的事别再拖延。","poem":["桃李花开正及时","东风送暖入帘帷","心中所愿休迟疑","趁取春光莫待迟"]},{"grade":"中平签","id":4,"jie":"暂且收敛锋芒，等风来再出发。","poem":["行船且候顺风潮","急水滩头莫逞豪","退后一步心自静","他年扬帆过石桥"]},{"grade":"中平签","id":5,"jie":"眼下困顿只是转弯处，再走几步就通了。","poem":["山重水复疑无路","柳暗花明又一村","莫将愁眼看世界","转过弯来即是春"]},{"grade":"上上签","id":6,"jie":"积累已够，只等一阵风，莫自轻看。","poem":["金鳞岂是池中物","一遇风云便化龙","多载寒窗无人问","今朝得遂平生志"]},{"grade":"中平签","id":7,"jie":"所求之外另有风景，换个眼光看问题。","poem":["明月清风本无价","近水远山皆有情","求名求利皆辛苦","不如归去听松声"]},{"grade":"下平签","id":8,"jie":"眼下清冷难熬，守住本心，忌冲动行事。","poem":["风雨潇潇夜未央","孤舟独钓寒江上","莫嫌鱼讯来迟缓","守得云开见月光"]},{"grade":"上签","id":9,"jie":"苦功不会白费，继续按自己的节奏走。","poem":["宝剑锋从磨砺出","梅花香自苦寒来","君家自有凌云志","不用扬鞭自奋蹄"]},{"grade":"中平签","id":10,"jie":"想通一件事的关键，是去找源头活水。","poem":["半亩方塘一鉴开","天光云影共徘徊","问渠那得清如许","为有源头活水来"]},{"grade":"上签","id":11,"jie":"牵挂的事很快有确切消息，安心等信。","poem":["喜鹊登枝报佳音","门前嘉客踏青云","多时悬悬心头事","今日方知有着落"]},{"grade":"下平签","id":12,"jie":"耳闻未必为实，少听多看，守成为上。","poem":["雾里看花花不真","水中望月月难亲","劝君莫听闲言语","守旧安然自有春"]},{"grade":"上上签","id":13,"jie":"天时地利人和齐备，放手去做。","poem":["旭日初升照大千","群山让路水让船","平生抱负今朝展","好风凭借力无边"]},{"grade":"中平签","id":14,"jie":"别为眼前小利乱了大局，稳住后手。","poem":["棋到中盘未分明","莫贪一子失全局","留得青山柴不尽","后发先至亦可期"]},{"grade":"上签","id":15,"jie":"困局得解，还会遇上意想不到的帮手。","poem":["久旱逢霖草木欣","他乡遇故倍知亲","心头旧事如云散","从此逍遥自在身"]},{"grade":"中平签","id":16,"jie":"少跟人比，自家田里按时耕，自有收成。","poem":["种瓜得瓜本寻常","莫羡他人插柳成","各人自有各人福","守得田园秋有成"]},{"grade":"下平签","id":17,"jie":"正处吃力阶段，最忌半途松劲，撑过去就好。","poem":["逆水行舟用力撑","一篙松劲退千寻","劝君且莫心先怯","咬紧牙关过险津"]},{"grade":"上签","id":18,"jie":"身边已有难得的人和事，用心珍惜。","poem":["兰室芝房香满庭","良缘夙缔自天成","莫教风雨摧残却","珍重眼前有福人"]},{"grade":"中平签","id":19,"jie":"想看清局面，先把自己的位置抬高一层。","poem":["欲穷千里目无涯","更上一层楼自佳","莫道高处不胜寒","眼界宽时天地大"]},{"grade":"上上签","id":20,"jie":"志向不妨定得大些，风已经起了。","poem":["鲲鹏展翅九万里","扶摇直上入云端","莫笑少年多壮志","他年回首已非凡"]}]